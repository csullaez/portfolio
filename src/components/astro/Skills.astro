---
import { skills } from '../../data/portfolio';
import type { SkillCategory } from '../../types/portfolio';
import { getTechIcon } from '../../lib/icons';
import SectionHeader from './SectionHeader.astro';

const categories: { key: SkillCategory; label: string; icon: string; accent: string }[] = [
  { key: 'backend', label: 'Backend', icon: 'devicon-nodejs-plain', accent: '#4f46e5' },
  { key: 'frontend', label: 'Frontend', icon: 'devicon-react-original', accent: '#38bdf8' },
  { key: 'tools', label: 'DevOps & Tools', icon: 'devicon-docker-plain', accent: '#10b981' }
];

const getSkillsByCategory = (category: SkillCategory) =>
  skills.filter((s) => s.category === category);
---

<section id="skills" class="py-24 bg-slate-50 dark:bg-[#0b0b0f] transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal">
      <SectionHeader
        eyebrow="// Stack"
        title="Habilidades"
        description="Tecnologías que domino y uso día a día para construir productos escalables."
      />
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {categories.map((category, index) => {
        const categorySkills = getSkillsByCategory(category.key);
        return (
          <div
            class={`reveal ${index === 1 ? 'reveal-delay-1' : index === 2 ? 'reveal-delay-2' : ''}`}
          >
            <div class="h-full rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-7 hover:shadow-lg hover:shadow-slate-200/50 dark:hover:shadow-black/30 transition-shadow">
              <div class="flex items-center gap-3 mb-8">
                <span class="w-11 h-11 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-2xl">
                  <i class={category.icon}></i>
                </span>
                <h3 class="font-display text-xl font-semibold text-slate-900 dark:text-white">
                  {category.label}
                </h3>
              </div>

              <div class="flex flex-wrap gap-2">
                {categorySkills.map((skill) => (
                  <span
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60 text-slate-700 dark:text-slate-200 text-sm font-medium hover:border-[var(--chip-accent)] transition-colors"
                    style={`--chip-accent: ${category.accent}`}
                  >
                    <i class={`${getTechIcon(skill.name)} text-base`}></i>
                    {skill.name}
                  </span>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>