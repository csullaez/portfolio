---
import { personalInfo } from '../../lib/config';
import ThemeToggle from '../react/ThemeToggle';

const navItems = [
  { label: 'Sobre mí', href: '#about' },
  { label: 'Proyectos', href: '#projects' },
  { label: 'Habilidades', href: '#skills' },
  { label: 'Experiencia', href: '#experience' },
  { label: 'Educación', href: '#education' },
  { label: 'Contacto', href: '#contact' }
];

const initials = `${personalInfo.name.charAt(0)}${personalInfo.lastName.charAt(0)}`;
---

<header class="fixed top-0 inset-x-0 z-50 bg-white/80 dark:bg-[#0b0b0f]/80 backdrop-blur-xl border-b border-slate-200/80 dark:border-slate-800/80">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between" aria-label="Navegación principal">
    <a href="#hero" class="flex items-center gap-3 group" aria-label="Inicio">
      <span class="w-9 h-9 rounded-lg bg-accent dark:bg-accent-dark-soft flex items-center justify-center font-display font-bold text-white dark:text-accent-dark text-lg shadow-sm group-hover:scale-105 transition-transform">
        {initials}
      </span>
      <span class="hidden sm:block text-sm font-semibold tracking-wide text-slate-900 dark:text-white">
        {personalInfo.name}
        <span class="text-accent dark:text-accent-dark">.</span>
      </span>
    </a>

    <ul class="hidden lg:flex items-center gap-7">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="nav-link text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <ThemeToggle client:load />
      <a
        href="#contact"
        class="hidden md:inline-flex items-center px-4 py-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-sm font-semibold rounded-lg hover:bg-accent dark:hover:bg-accent dark:hover:text-white transition-colors"
      >
        Contáctame
      </a>
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 -mr-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="lg:hidden overflow-hidden bg-white/95 dark:bg-[#0b0b0f]/95 backdrop-blur-xl border-t border-slate-200/80 dark:border-slate-800/80 transition-[max-height,opacity] duration-300 ease-out"
    style="max-height:0; opacity:0; pointer-events:none;"
    aria-hidden="true"
  >
    <ul class="px-6 py-4 flex flex-col gap-1">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="block py-3 px-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white font-medium transition-colors"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    border-radius: 9999px;
    background: var(--color-accent);
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    opacity: 1;
    transform: scaleX(1);
  }
  .nav-link.is-active {
    color: var(--color-accent);
  }
  .dark .nav-link.is-active {
    color: var(--color-accent-dark);
  }
</style>

<script is:inline>
  (function () {
    function init() {
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');

      function setMenu(open) {
        if (!menuBtn || !mobileMenu) return;
        mobileMenu.style.maxHeight = open ? mobileMenu.scrollHeight + 'px' : '0';
        mobileMenu.style.opacity = open ? '1' : '0';
        mobileMenu.style.pointerEvents = open ? 'auto' : 'none';
        mobileMenu.setAttribute('aria-hidden', open ? 'false' : 'true');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        menuBtn.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
      }

      menuBtn?.addEventListener('click', () => {
        setMenu(mobileMenu.getAttribute('aria-hidden') === 'true');
      });

      document.querySelectorAll('#mobile-menu a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });

      const links = document.querySelectorAll('.nav-link');
      const sections = [];
      links.forEach((link) => {
        const id = link.getAttribute('href');
        if (id && id.startsWith('#')) {
          const el = document.querySelector(id);
          if (el) sections.push({ link, el });
        }
      });

      if ('IntersectionObserver' in window && sections.length) {
        const spy = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                sections.forEach(({ link }) => link.classList.remove('is-active'));
                const match = sections.find(({ el }) => el === entry.target);
                match?.link.classList.add('is-active');
              }
            });
          },
          { rootMargin: '-40% 0px -55% 0px' }
        );
        sections.forEach(({ el }) => spy.observe(el));
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
