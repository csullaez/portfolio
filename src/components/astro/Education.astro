---
import { education } from '../../data/portfolio';

const getTypeStyles = (type: string) => {
  switch (type) {
    case 'degree':
      return { bg: 'bg-indigo-100 dark:bg-indigo-900/50', text: 'text-indigo-700 dark:text-indigo-300', icon: '🎓' };
    case 'certification':
      return { bg: 'bg-emerald-100 dark:bg-emerald-900/50', text: 'text-emerald-700 dark:text-emerald-300', icon: '📜' };
    default:
      return { bg: 'bg-slate-100 dark:bg-slate-700', text: 'text-slate-700 dark:text-slate-300', icon: '📝' };
  }
};
---

<section id="education" class="py-20 bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4">Educación</h2>
      <div class="w-20 h-1 bg-gradient-to-r from-indigo-600 to-purple-600 mx-auto rounded-full"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {education.map((edu) => {
        const styles = getTypeStyles(edu.type);
        return (
          <article class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-4">
              <div class={`w-14 h-14 ${styles.bg} ${styles.text} rounded-xl flex items-center justify-center text-2xl shrink-0`}>
                {styles.icon}
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2 flex-wrap">
                  <span class={`px-3 py-1 ${styles.bg} ${styles.text} text-xs font-medium rounded-full`}>
                    {edu.type === 'degree' ? 'Grado' : 'Certificación'}
                  </span>
                  <span class="text-sm text-slate-500 dark:text-slate-400">{edu.period}</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">{edu.title}</h3>
                <p class="text-indigo-600 dark:text-indigo-400 font-medium mb-2">{edu.institution}</p>
                {edu.description && (
                  <p class="text-slate-600 dark:text-slate-400 text-sm">{edu.description}</p>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
