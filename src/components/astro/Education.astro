---
import { education } from '../../data/portfolio';
import SectionHeader from './SectionHeader.astro';

const typeStyles = {
  degree: { label: 'Grado', badge: 'bg-accent-soft dark:bg-accent-dark-soft text-accent-strong dark:text-accent-dark', icon: '🎓' },
  certification: { label: 'Certificación', badge: 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300', icon: '📜' },
  course: { label: 'Curso', badge: 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300', icon: '📝' }
};
---

<section id="education" class="py-24 bg-slate-50 dark:bg-[#0b0b0f] transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal">
      <SectionHeader
        eyebrow="// Formación"
        title="Educación"
        description="Formación académica, postgrados y certificaciones."
      />
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {education.map((edu, index) => {
        const styles = typeStyles[edu.type] || typeStyles.course;
        return (
          <article
            class={`reveal ${index % 2 === 1 ? 'reveal-delay-1' : ''} rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 hover:shadow-lg hover:shadow-slate-200/50 dark:hover:shadow-black/30 transition-shadow`}
          >
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 shrink-0 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-2xl">
                <span aria-hidden="true">{styles.icon}</span>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2 flex-wrap">
                  <span class={`px-2.5 py-0.5 rounded-md text-xs font-medium ${styles.badge}`}>
                    {styles.label}
                  </span>
                  <span class="font-mono text-xs text-slate-400 dark:text-slate-500">
                    {edu.period}
                  </span>
                </div>
                <h3 class="text-base font-semibold text-slate-900 dark:text-white leading-snug">
                  {edu.title}
                </h3>
                <p class="text-sm font-medium text-accent dark:text-accent-dark mt-1">
                  {edu.institution}
                </p>
                {edu.description && (
                  <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
                    {edu.description}
                  </p>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>