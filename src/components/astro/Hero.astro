---
import { personalInfo } from '../../lib/config';

const roleSegments = personalInfo.role.split('|').map((s) => s.trim());
const githubUrl = personalInfo.socialLinks.find((l) => l.icon === 'github')?.url;
const initials = `${personalInfo.name.charAt(0)}${personalInfo.lastName.charAt(0)}`;

const heroTech = [
  { name: 'TypeScript', icon: 'devicon-typescript-plain', position: 'top-6 -left-6' },
  { name: 'Node.js', icon: 'devicon-nodejs-plain', position: 'top-1/3 -right-4' },
  { name: 'PostgreSQL', icon: 'devicon-postgresql-plain', position: 'bottom-24 -left-8' },
  { name: 'Docker', icon: 'devicon-docker-plain', position: '-bottom-4 right-10' }
];
---

<section
  id="hero"
  class="relative min-h-screen flex items-center pt-28 pb-16 overflow-hidden bg-white dark:bg-[#0b0b0f] grain"
>
  <div class="orb w-96 h-96 bg-accent/10 dark:bg-accent/10 -top-24 -right-24" aria-hidden="true"></div>
  <div class="orb w-80 h-80 bg-violet-400/10 dark:bg-violet-500/10 bottom-0 -left-32" style="animation-delay:-6s" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-6 w-full">
    <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-16 items-center">
      <div class="reveal">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-slate-200 dark:border-slate-800 bg-white/60 dark:bg-white/5 text-slate-600 dark:text-slate-300 text-sm">
          <span class="relative flex w-2.5 h-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span>
            <span class="relative inline-flex rounded-full w-2.5 h-2.5 bg-emerald-500"></span>
          </span>
          <span class="font-mono text-xs">Disponible para proyectos</span>
        </div>

        <p class="mt-8 font-mono text-xs uppercase tracking-[0.3em] text-accent dark:text-accent-dark">
          &lt;fullstack developer /&gt;
        </p>

        <h1 class="mt-3 font-display text-5xl md:text-6xl lg:text-7xl font-semibold text-slate-900 dark:text-white tracking-tight leading-[1.05]">
          {personalInfo.name}
          <br />
          <span class="text-accent dark:text-accent-dark italic">{personalInfo.lastName}</span>
        </h1>

        <div class="mt-6 flex flex-wrap gap-2">
          {roleSegments.map((segment) => (
            <span
              class="px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 font-mono text-xs font-medium border border-slate-200 dark:border-slate-700"
            >
              {segment}
            </span>
          ))}
        </div>

        <p class="mt-6 text-base md:text-lg text-slate-500 dark:text-slate-400 leading-relaxed max-w-xl">
          {personalInfo.description}
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-accent hover:bg-accent-strong text-white font-semibold rounded-lg transition-all duration-200 hover:shadow-lg hover:shadow-accent/20"
          >
            Contactar
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-semibold rounded-lg border border-slate-200 dark:border-slate-700 hover:border-accent hover:text-accent dark:hover:text-accent-dark transition-all duration-200"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              GitHub
            </a>
          )}
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-slate-500 dark:text-slate-400">
          <a href={`mailto:${personalInfo.email}`} class="flex items-center gap-2 hover:text-accent dark:hover:text-accent-dark transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {personalInfo.email}
          </a>
          {personalInfo.phone && (
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              {personalInfo.phone}
            </span>
          )}
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
            {personalInfo.location}
          </span>
        </div>
      </div>

      <div class="reveal reveal-delay-2 hidden sm:block">
        <div class="relative max-w-md mx-auto lg:ml-auto">
          {heroTech.map((tech) => (
            <div
              class={`absolute ${tech.position} z-20 w-12 h-12 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-lg flex items-center justify-center text-2xl hover:scale-110 transition-transform`}
              title={tech.name}
            >
              <i class={`${tech.icon}`}></i>
            </div>
          ))}

          <div class="relative rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 backdrop-blur-sm shadow-xl shadow-slate-200/60 dark:shadow-black/40 overflow-hidden">
            <div class="flex items-center gap-2 px-4 py-3 border-b border-slate-100 dark:border-slate-800">
              <span class="w-3 h-3 rounded-full bg-red-400"></span>
              <span class="w-3 h-3 rounded-full bg-amber-400"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
              <span class="ml-2 font-mono text-xs text-slate-400">~/portfolio</span>
            </div>

            <div class="px-6 py-10 text-center">
              <div class="font-mono text-xs text-slate-400 mb-6">$ whoami</div>
              <div class="font-display text-7xl md:text-8xl font-semibold text-slate-900 dark:text-white">
                {initials}
              </div>
              <div class="mt-4 font-mono text-sm text-slate-500 dark:text-slate-400">
                {personalInfo.name} {personalInfo.lastName}
              </div>
              <div class="mt-8 flex items-center justify-center gap-3">
                <i class="devicon-typescript-plain text-2xl" title="TypeScript"></i>
                <i class="devicon-nodejs-plain text-2xl" title="Node.js"></i>
                <i class="devicon-postgresql-plain text-2xl" title="PostgreSQL"></i>
                <i class="devicon-nestjs-plain text-2xl" title="NestJS"></i>
                <i class="devicon-react-original text-2xl" title="React"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
