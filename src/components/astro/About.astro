---
import { languages, experience, projects } from '../../data/portfolio';
import { personalInfo } from '../../lib/config';
import SectionHeader from './SectionHeader.astro';

const years = (() => {
  const years = experience
    .map((exp) => {
      const match = exp.period.match(/\d{4}/);
      return match ? parseInt(match[0], 10) : null;
    })
    .filter((y): y is number => y !== null);
  return years.length ? new Date().getFullYear() - Math.min(...years) : 5;
})();

const institutions = new Set(experience.map((exp) => exp.company.split(' - ')[0]));

const stats = [
  { value: `${years}+`, label: 'Años de experiencia' },
  { value: `${projects.length}+`, label: 'Proyectos en producción' },
  { value: `${institutions.size}+`, label: 'Instituciones públicas y privadas' }
];

const focus = [
  {
    title: 'Backend',
    icon: 'devicon-nestjs-plain',
    text: 'Node.js, NestJS, Express, TypeScript, APIs REST y microservicios'
  },
  {
    title: 'Frontend',
    icon: 'devicon-react-original',
    text: 'React, Next.js, Vue.js, Material UI y Tailwind CSS'
  },
  {
    title: 'Bases de datos',
    icon: 'devicon-postgresql-plain',
    text: 'PostgreSQL, MySQL, MongoDB, Redis y TypeORM'
  },
  {
    title: 'DevOps',
    icon: 'devicon-docker-plain',
    text: 'Docker, Nginx, PM2, CI/CD y Linux'
  }
];
---

<section id="about" class="py-24 bg-white dark:bg-[#0b0b0f] transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal">
      <SectionHeader
        eyebrow="// Quién soy"
        title="Sobre Mí"
        description="Ingeniero de software con foco en arquitectura de backend, datos y sistemas de alto impacto en producción."
      />
    </div>

    <div class="grid lg:grid-cols-2 gap-14 items-start">
      <div class="space-y-8 reveal">
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-lg">
          {personalInfo.description}
        </p>

        <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
          Experiencia en despliegue y mantenimiento de sistemas en entornos Linux utilizando Docker, Nginx y PM2,
          participando en proyectos de alto impacto y trabajando en equipos de desarrollo bajo buenas prácticas de
          arquitectura y calidad de software.
        </p>

        <div class="grid grid-cols-3 gap-4">
          {stats.map((stat) => (
            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 text-center">
              <div class="font-display text-3xl md:text-4xl font-semibold text-accent dark:text-accent-dark">
                {stat.value}
              </div>
              <div class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-snug">
                {stat.label}
              </div>
            </div>
          ))}
        </div>

        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 p-6">
          <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 mb-4">
            Idiomas
          </h3>
          <div class="flex flex-wrap gap-2.5">
            {languages.map((lang) => (
              <span class="px-4 py-2 bg-white dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-sm font-medium">
                {lang.name}
                <span class="text-slate-400 dark:text-slate-500"> · {lang.level}</span>
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="space-y-4 reveal reveal-delay-1">
        {focus.map((item) => (
          <div class="group flex items-start gap-5 p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-accent/40 dark:hover:border-accent-dark/40 transition-colors">
            <div class="w-12 h-12 shrink-0 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">
              <i class={item.icon}></i>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 dark:text-white mb-1">{item.title}</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
