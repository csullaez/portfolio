---
import { experience } from '../../data/portfolio';
import { getTechIcon } from '../../lib/icons';
import SectionHeader from './SectionHeader.astro';
---

<section id="experience" class="py-24 bg-white dark:bg-[#0b0b0f] transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal">
      <SectionHeader
        eyebrow="// Trayectoria"
        title="Experiencia Laboral"
        description="Proyectos de alto impacto en el sector público y privado de Bolivia."
      />
    </div>

    <div class="relative max-w-3xl mx-auto">
      <div class="absolute left-4 top-0 bottom-0 w-px bg-slate-200 dark:bg-slate-800" aria-hidden="true"></div>

      <div class="space-y-10">
        {experience.map((exp) => (
          <div class="relative pl-14">
            <span
              class="absolute left-4 -translate-x-1/2 top-7 w-3 h-3 rounded-full bg-accent ring-4 ring-accent/15 dark:ring-accent-dark/20"
              aria-hidden="true"
            ></span>

            <article class="reveal rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-7 hover:border-accent/30 dark:hover:border-accent-dark/30 transition-colors">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="px-3 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-mono text-xs font-medium">
                  {exp.period}
                </span>
                <span class="px-3 py-1 rounded-md bg-accent-soft dark:bg-accent-dark-soft text-accent-strong dark:text-accent-dark font-mono text-xs font-medium">
                  {exp.location}
                </span>
              </div>

              <h3 class="text-lg font-semibold text-slate-900 dark:text-white leading-snug">
                {exp.role}
              </h3>
              <p class="text-sm font-medium text-accent dark:text-accent-dark mt-0.5">
                {exp.company}
              </p>

              <ul class="mt-4 space-y-2.5">
                {exp.achievements.map((achievement) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                    <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-accent dark:bg-accent-dark shrink-0" aria-hidden="true"></span>
                    {achievement}
                  </li>
                ))}
              </ul>

              {exp.technologies.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-5 pt-5 border-t border-slate-100 dark:border-slate-800">
                  {exp.technologies.slice(0, 6).map((tech) => (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-medium">
                      <i class={`${getTechIcon(tech)} text-sm`}></i>
                      {tech}
                    </span>
                  ))}
                  {exp.technologies.length > 6 && (
                    <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-xs">
                      +{exp.technologies.length - 6}
                    </span>
                  )}
                </div>
              )}
            </article>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>