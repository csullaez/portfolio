---
import { experience } from '../../data/portfolio';
---

<section id="experience" class="py-20 bg-white dark:bg-slate-900 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4">Experiencia Laboral</h2>
      <div class="w-20 h-1 bg-gradient-to-r from-indigo-600 to-purple-600 mx-auto rounded-full"></div>
    </div>

    <div class="relative">
      <div class="absolute left-0 md:left-1/2 transform md:-translate-x-px h-full w-0.5 bg-slate-200 dark:bg-slate-700"></div>

      <div class="space-y-8">
        {experience.map((exp, index) => (
          <div key={exp.id} class={`relative flex flex-col md:flex-row gap-6 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
            <div class="flex-1 md:pr-12">
              <div class="bg-slate-50 dark:bg-slate-800 rounded-2xl p-6 hover:shadow-lg transition-all duration-300 border border-slate-100 dark:border-slate-700">
                <div class="flex items-center gap-2 mb-3 flex-wrap">
                  <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 text-xs font-medium rounded-full">
                    {exp.period}
                  </span>
                  <span class="px-3 py-1 bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium rounded-full">
                    {exp.location}
                  </span>
                </div>
                
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">{exp.role}</h3>
                <p class="text-indigo-600 dark:text-indigo-400 font-medium mb-4">{exp.company}</p>
                
                <ul class="space-y-2">
                  {exp.achievements.map((achievement, i) => (
                    <li key={i} class="text-slate-600 dark:text-slate-300 text-sm flex items-start gap-2">
                      <span class="text-indigo-600 dark:text-indigo-400 mt-0.5 shrink-0">•</span>
                      {achievement}
                    </li>
                  ))}
                </ul>
                
                {exp.technologies.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-slate-200 dark:border-slate-700">
                    {exp.technologies.slice(0, 6).map((tech) => (
                      <span key={tech} class="px-2 py-1 bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs rounded font-medium">
                        {tech}
                      </span>
                    ))}
                    {exp.technologies.length > 6 && (
                      <span class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 text-xs rounded">
                        +{exp.technologies.length - 6}
                      </span>
                    )}
                  </div>
                )}
              </div>
            </div>

            <div class="absolute left-0 md:left-1/2 transform -translate-x-1/2 w-4 h-4 rounded-full bg-indigo-600 dark:bg-indigo-500 border-4 border-white dark:border-slate-900 shadow z-10"></div>

            <div class="flex-1 md:pl-12 hidden md:block">
              <div class="h-full flex items-center">
                <div class="bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 rounded-xl p-6 w-full">
                  <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900/50 rounded-lg flex items-center justify-center">
                      <span class="text-2xl">💼</span>
                    </div>
                    <div>
                      <p class="text-xs text-slate-500 dark:text-slate-400">Empresa</p>
                      <p class="text-sm font-semibold text-slate-900 dark:text-white">{exp.company.split(' - ')[0]}</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/50 rounded-lg flex items-center justify-center">
                      <span class="text-2xl">📍</span>
                    </div>
                    <div>
                      <p class="text-xs text-slate-500 dark:text-slate-400">Ubicación</p>
                      <p class="text-sm font-semibold text-slate-900 dark:text-white">{exp.location}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
