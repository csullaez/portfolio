---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada | Portfolio">
  <section class="min-h-[70vh] flex items-center justify-center px-6 pt-16 bg-white dark:bg-[#0b0b0f]">
    <div class="text-center">
      <p class="font-mono text-6xl md:text-8xl font-bold text-slate-200 dark:text-slate-800">404</p>
      <h1 class="mt-4 font-display text-3xl md:text-4xl font-semibold text-slate-900 dark:text-white">
        Página no encontrada
      </h1>
      <p class="mt-3 text-slate-500 dark:text-slate-400">
        La página que buscas no existe o fue movida.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 mt-8 px-6 py-3 bg-accent hover:bg-accent-strong text-white font-semibold rounded-lg transition-colors"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>