# ── Configuración del sitio ──────────────────────────────────────────────
# Nombre mostrado en el header/footer/SEO
PUBLIC_SITE_NAME=Carlos Sullaez Butron
# URL pública de despliegue (usada para canonical, sitemap y OG tags)
# En Vercel usa tu dominio, p.ej: https://portfolio-<slug>.vercel.app
PUBLIC_SITE_URL=https://portfolio.vercel.app

# ── Datos personales ─────────────────────────────────────────────────────
PUBLIC_PERSONAL_NAME=Carlos Sullaez
PUBLIC_PERSONAL_LAST_NAME=Butron
PUBLIC_PERSONAL_ROLE=Desarrollador Fullstack TypeScript | Administrador de Base de Datos | Docente
PUBLIC_PERSONAL_DESCRIPTION=Desarrollador Fullstack con más de 5 años de experiencia construyendo aplicaciones web en producción...
PUBLIC_PERSONAL_EMAIL=carlos.sullaez.dev@gmail.com
PUBLIC_PERSONAL_PHONE=+591 75821602
PUBLIC_PERSONAL_LOCATION=La Paz, Bolivia
# Ruta del CV dentro de public/. El enlace solo se muestra si el archivo existe.
PUBLIC_PERSONAL_CV_URL=/CV.pdf

# ── Formulario de contacto (Resend, solo servidor) ───────────────────────
# Crea una cuenta gratuita en https://resend.com y obtén tu API key en
# https://resend.com/api-keys. Estas variables NO llevan prefijo PUBLIC_ y
# nunca se exponen al navegador. Configúralas en Vercel > Settings > Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Correo al que llegan los mensajes del formulario
CONTACT_EMAIL=carlos.sullaez.dev@gmail.com
